# Optional AI assistance. Leave every value blank for the fully deterministic,
# offline solver. Never commit a populated .env file.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
LLM_MAX_RETRIES=2

# Evidence-specific overrides. When blank, LLM_PROVIDER and LLM_MODEL are used.
EVIDENCE_MODEL_PROVIDER=
EVIDENCE_MODEL_MODEL=
