# Optional AI assistance. Leave every value blank for the fully deterministic,
# offline solver. Never commit a populated .env file.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
LLM_MAX_RETRIES=2

# Evidence-specific overrides. When blank, LLM_PROVIDER and LLM_MODEL are used.
EVIDENCE_MODEL_PROVIDER=
EVIDENCE_MODEL_MODEL=

# Optional local image OCR. Requires the Tesseract executable to be installed
# locally. When enabled, OCR can emit an amount only when it is explicitly
# paired with the linked event's known currency; ambiguous OCR output is ignored.
LOCAL_OCR_ENABLED=
LOCAL_OCR_COMMAND=
